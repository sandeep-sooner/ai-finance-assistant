# Copy to .env and fill in. Never commit .env.
#
# Only the API keys are needed. Every other value has a default in config.yaml;
# set a variable here only to override that default (an empty value means "use config.yaml").

# ---------- LLM provider and keys ----------
# LLM_PROVIDER: openai | gemini | fake (demo mode, canned replies, no network).
# If unset, it picks openai if OPENAI_API_KEY is set, else gemini if GOOGLE_API_KEY is set, else fake.
LLM_PROVIDER=openai
OPENAI_API_KEY=
# Only if your key goes through a proxy (e.g. a course-provided endpoint)
OPENAI_BASE_URL=
# Optional second provider. If both keys are set, the other provider's models join the fallback chain.
GOOGLE_API_KEY=

# ---------- Model router: easy questions -> fast model, hard ones -> smart model ----------
# Fast (cheap) tier. LLM_MODEL is the older name for the same setting and still works.
LLM_FAST_MODEL=gpt-4o-mini
# Smart tier. Set it to the same value as the fast model to switch model routing off.
LLM_SMART_MODEL=gpt-4o
# Complexity score (0..1) at or above which a question goes to the smart model.
MODEL_ROUTER_THRESHOLD=0.5
# Ask the fast model to pick the agent when no routing rule matches (true | false).
ROUTER_LLM_FALLBACK=true
LLM_TEMPERATURE=0.3

# ---------- Fallback system ----------
# Extra attempts on the same model before switching to the next one.
LLM_RETRIES=2
# Seconds before the first retry; doubles each attempt, plus jitter.
LLM_BACKOFF_BASE=0.5
# Seconds to wait for the next streamed token before treating the model as failed.
LLM_TOKEN_TIMEOUT=30

# ---------- Caching ----------
# Seconds an LLM answer is reused for an identical prompt. 0 turns the response cache off.
LLM_CACHE_TTL=3600

# ---------- Knowledge base (RAG) ----------
# openai | local | auto. auto = OpenAI embeddings when LLM_PROVIDER=openai, else the local embedder.
# local needs no network or key (hashed TF-IDF); tests and evals always use it.
RAG_EMBEDDER=auto
RAG_EMBEDDING_MODEL=text-embedding-3-small
# Articles returned per question, and the minimum relevance score to be shown to the model.
RAG_TOP_K=4
RAG_MIN_SCORE=0.22
# Where the FAISS index and the embedding cache are stored.
RAG_INDEX_DIR=.cache/rag

# ---------- Market data ----------
# yfinance (live, may be delayed ~15 min) | alphavantage | sample (offline, illustrative prices)
MARKET_DATA_PROVIDER=yfinance
# Optional. With yfinance as primary, Alpha Vantage becomes the second live source when this is set.
# Required when MARKET_DATA_PROVIDER=alphavantage. Free key: https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=
# Seconds a quote is reused. The course FAQ suggests 1800 on free API tiers.
MARKET_QUOTE_TTL=60
MARKET_TIMEOUT=8

# ---------- LangSmith tracing (optional) ----------
# Sends a trace of every chat turn to https://smith.langchain.com: graph steps, prompts, model calls,
# retrieved articles, plus this app's own labels (model tier, cache hit, fallbacks, route).
# Note: this uploads user messages and prompts to LangSmith. Leave it off if that is not acceptable.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
# Traces are grouped under this project name in the LangSmith UI.
LANGSMITH_PROJECT=ai-finance-assistant
# Must match the region your LangSmith account is in (see the address bar when logged in).
# A key used against the wrong region is rejected with 403 Forbidden and no traces arrive.
#   smith.langchain.com      -> leave unset (default US endpoint)
#   aws.smith.langchain.com  -> https://aws.api.smith.langchain.com
#   eu.smith.langchain.com   -> https://eu.api.smith.langchain.com
LANGSMITH_ENDPOINT=

# ---------- API limits and logging ----------
# Global cap on LLM calls per minute (keep under your key's rate limit).
LLM_CALLS_PER_MIN=50
# Per-client caps: endpoints that call the LLM / data-only endpoints.
CHAT_REQUESTS_PER_MIN=20
API_REQUESTS_PER_MIN=120
MAX_HISTORY_MESSAGES=10
MAX_MESSAGE_CHARS=2000
# Only needed if the browser talks to the API directly instead of through the Vite proxy
CORS_ORIGINS=
LOG_LEVEL=INFO
